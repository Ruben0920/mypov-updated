# Django
DJANGO_SECRET_KEY=replace-with-random-secret-key
DEBUG=True

# Zero-Knowledge Identity & Hardware Anti-Abuse
DEVICE_HASH_PEPPER=replace-with-random-hmac-pepper
ZK_LIVENESS_VERIFIER=users.verification.DeterministicLocalLivenessVerifier

# Database (SQLite is used by default unless USE_POSTGRES=true)
USE_POSTGRES=false
POSTGRES_DB=my_pov
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SMTP (for forgot-password OTP)
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=

# Pusher (optional realtime chat events)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# AI (optional legacy object/interest inference)
GEMINI_API_KEY=
